# Copy to `.env` and adjust for local development.
# JWT_SECRET is required and must be at least 32 characters long.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Listening addresses
BLOG_HTTP_ADDR=127.0.0.1:8080
BLOG_GRPC_ADDR=127.0.0.1:50051

# Leave unset in development to allow any origin (e.g. for the Trunk dev server).
# CORS_ALLOWED_ORIGIN=http://127.0.0.1:8081

# Logging filter (tracing EnvFilter syntax)
RUST_LOG=info,blog_server=debug,actix_web=info
